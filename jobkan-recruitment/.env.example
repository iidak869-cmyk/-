# このファイルを .env にコピーして値を設定してください（.env はgit管理対象外）

# ブラウザ表示（初回動作確認は false = 画面を表示、タスクスケジューラ運用時は true 推奨）
HEADLESS=false
# 操作の速度をわざと落とす（ms）。動作確認時は 200 程度、本番は 0 でOK
SLOWMO_MS=200

# --- AirWORK ---
# ログインURL（実際のログインページのURLに要変更）
AIRWORK_LOGIN_URL=https://ats.rct.airregi.jp/login
AIRWORK_ID=
AIRWORK_PASSWORD=

# --- doda ---
# ログインURL（実際のログインページのURLに要変更）
DODA_LOGIN_URL=https://xtensor.doda.jp/
DODA_ID=
DODA_PASSWORD=

# --- フォルダパス（すべて仮パス。本番フォルダ作成後に差し替え） ---
# ブラウザの標準ダウンロード先（通常は変更不要）
DOWNLOAD_DIR=
# 「応募者リスト」フォルダ（CSV格納先）
APPLICANT_LIST_DIR=
# 反映用リスト.xlsx のフルパス
REFLECT_EXCEL_PATH=
# 応募者数CSVフォルダのルートパス
APPLICANT_CSV_ROOT_DIR=
# コピー先の共有ドライブパス
SHARED_DRIVE_DEST_DIR=G:\共有ドライブ\RPA運用-採用課連携
